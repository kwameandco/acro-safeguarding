# Acro Safeguarding Hub — copy to .env.local and fill in.
# .env.local is gitignored. Never commit real values.
#
# ⚠️ The Supabase project for this portal DOES NOT EXIST YET (as of 2026-08-27).
# Until it is created, leave these unset — the app fails closed to
# /auth/error?reason=config, which is the wrong-database guard doing its job,
# not a bug. See docs/SUPABASE_SETUP.md for the connect-up runbook.

# The project ref pin. lib/supabase/project-ref.ts refuses ANY remote
# connection unless NEXT_PUBLIC_SUPABASE_URL's ref matches this value — a stale
# URL inherited from the shell (AcroPassport's, SLAC's) must never be used.
NEXT_PUBLIC_SUPABASE_PROJECT_REF=

# Supabase — fill in once the project exists. URL must be
# https://<NEXT_PUBLIC_SUPABASE_PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses RLS — server-side only, never NEXT_PUBLIC_.
# Needed only by the invite server action (admin.inviteUserByEmail).
SUPABASE_SERVICE_ROLE_KEY=

# Public origin, used to build magic-link redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
